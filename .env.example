# cp .env.example .env
# Sostituisci i valori

TELEGRAM_BOT_TOKEN=INSERISCI_IL_TOKEN_DI_BOTFATHER
TELEGRAM_USER_ID_ADMIN=123456789

# Opzionale: percorso del database SQLite (default: todo.db nella root del progetto).
# Se lo imposti, la cartella deve esistere e ReadWritePaths nell'unit systemd deve puntare alla stessa cartella.
TODO_DB_PATH=/cambia/il/percorso